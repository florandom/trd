{
  "components": {
    "schemas": {
      "Applied": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "Applied",
        "type": "object"
      },
      "Apply": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "$ref": "#/components/schemas/Change"
          },
          "confirmation_token": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Confirmation Token",
            "type": "string"
          }
        },
        "required": [
          "change",
          "confirmation_token"
        ],
        "title": "Apply",
        "type": "object"
      },
      "Challenge": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "Challenge",
        "type": "object"
      },
      "Change": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "settings",
              "risk",
              "agent",
              "source",
              "paper_position",
              "paper_resume"
            ],
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "required": [
          "kind",
          "target",
          "expected_version",
          "value"
        ],
        "title": "Change",
        "type": "object"
      },
      "Confirmation": {
        "properties": {
          "change": {
            "$ref": "#/components/schemas/Change"
          },
          "confirmation_token": {
            "title": "Confirmation Token",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "confirmation_token",
          "expires_at",
          "change",
          "digest"
        ],
        "title": "Confirmation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthLiveness": {
        "additionalProperties": false,
        "properties": {
          "phase": {
            "const": 1,
            "default": 1,
            "title": "Phase",
            "type": "integer"
          },
          "service": {
            "enum": [
              "api",
              "risk",
              "simulator"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "HealthLiveness",
        "type": "object"
      },
      "HealthReadiness": {
        "additionalProperties": false,
        "properties": {
          "automation_enabled": {
            "const": false,
            "default": false,
            "title": "Automation Enabled",
            "type": "boolean"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "mode": {
            "const": "paper",
            "default": "paper",
            "title": "Mode",
            "type": "string"
          },
          "phase": {
            "const": 1,
            "default": 1,
            "title": "Phase",
            "type": "integer"
          },
          "service": {
            "const": "api",
            "default": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at"
        ],
        "title": "HealthReadiness",
        "type": "object"
      },
      "JsonValue": {},
      "LoginInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^\\s\\x00]+@[^\\s\\x00]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "OperationalRows": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "environment_id": {
            "title": "Environment Id",
            "type": "string"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "rows": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/JsonValue"
                  },
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "format": "uuid",
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "rows",
          "has_more",
          "offset",
          "checked_at",
          "environment_id"
        ],
        "title": "OperationalRows",
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "idle_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Expires At"
          },
          "role": {
            "enum": [
              "ADMIN",
              "VIEWER"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "csrf_token"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Trading orchestration foundation",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "auth_challenge",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Challenge"
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me"
      }
    },
    "/config/apply": {
      "post": {
        "operationId": "apply_config_change",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Apply"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Applied"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Apply"
      }
    },
    "/config/confirm": {
      "post": {
        "operationId": "confirm_config_change",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Confirmation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/ops/signals/{identifier}": {
      "get": {
        "operationId": "signal_detail",
        "parameters": [
          {
            "in": "path",
            "name": "identifier",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Identifier",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Signal"
      }
    },
    "/ops/{collection}": {
      "get": {
        "operationId": "operational_rows",
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "required": true,
            "schema": {
              "title": "Collection",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalRows"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rows"
      }
    },
    "/trading/{action}": {
      "post": {
        "operationId": "trading_unavailable",
        "parameters": [
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "title": "Action",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unavailable"
      }
    }
  }
}
