# production template. pnpm env:new generates independent private secrets; finish Cloudflare configuration before starting.
# This operator file is never passed wholesale to application containers.
APP_ENV=production
RUNTIME_STATE_DIR=REPLACE_WITH_ABSOLUTE_PRIVATE_STATE_DIRECTORY
REMOTE_ACCESS_MODE=cloudflare
DASHBOARD_PROXY_SECRET=__GENERATE__
CF_ACCESS_CLIENT_ID=REPLACE_WITH_ENVIRONMENT_SERVICE_TOKEN_ID
CF_ACCESS_CLIENT_SECRET=REPLACE_WITH_ENVIRONMENT_SERVICE_TOKEN_SECRET
CLOUDFLARE_ACCESS_ISSUER=https://replace-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=REPLACE_WITH_DASHBOARD_ACCESS_AUD
APP_URL=https://dashboard-production.example.com
ENVIRONMENT_ID=production-paper
TIMEZONE=Europe/Rome
LOG_LEVEL=INFO
TRADING_MODE=paper
ENABLE_AUTOMATION=false
ENABLE_LIVE_TRADING=false

# Local database. Separate role passwords are generated during setup.
POSTGRES_DB=trd_production
POSTGRES_USER=trd_bootstrap
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
DATABASE_ADMIN_URL=__GENERATE__
MIGRATION_DATABASE_URL=__GENERATE__
API_DATABASE_URL=__GENERATE__
COLLECTOR_DATABASE_URL=__GENERATE__
AI_DATABASE_URL=__GENERATE__
RISK_DATABASE_URL=__GENERATE__
MAINTENANCE_DATABASE_URL=__GENERATE__

# Explicit bootstrap only; neither value goes to API/worker processes.
ADMIN_BOOTSTRAP_EMAIL=admin@localhost.invalid
ADMIN_BOOTSTRAP_PASSWORD=__GENERATE__
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_IDLE_TTL_SECONDS=1800
AUTH_MFA_REQUIRED=true
ENCRYPTION_KEY=__GENERATE__

# Optional cache, never a correctness dependency.
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Telegram reading requires explicit enrollment; all trading remains disabled.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=__GENERATE__
TELEGRAM_SESSION_PATH=data/telegram.session.enc
TELEGRAM_SESSION_KEY_ID=local-v1
TELEGRAM_COLLECTOR_IDENTITY=primary
TELEGRAM_POLL_SECONDS=30
TELEGRAM_BACKFILL_MAX_AGE_SECONDS=86400
TELEGRAM_HISTORY_BATCH_SIZE=100
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20
TELEGRAM_SIGNAL_MAX_AGE_SECONDS=900
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MOONSHOT_API_KEY=
TYPESAFE_API_KEY=
AI_PROVIDER_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MANIFEST_PATH=
OPENROUTER_ACCEPTANCE_PATH=
AI_HARD_MAX_INPUT_TOKENS=131072
AI_HARD_DAILY_BUDGET_USD=0.00
AI_HARD_MONTHLY_BUDGET_USD=0.00
AI_HARD_DAILY_BUDGET_PER_AGENT_USD=0.00
AI_HARD_MAX_COST_PER_REQUEST_USD=0.00
AI_HARD_MAX_OUTPUT_TOKENS=4096
AI_HARD_TIMEOUT_SECONDS=30
AI_SIGNAL_MAX_AGE_SECONDS=900
AI_JOB_LEASE_SECONDS=180

# Bridge enrollment/protocol arrives later. These keys alone enable nothing.
MT5_BRIDGE_SHARED_SECRET=__GENERATE__
MT5_COMMAND_SIGNING_KEY=__GENERATE__
MT5_ALLOWED_ACCOUNT_IDS=[]
MT5_BRIDGE_INSTANCE_ID=unpaired
MT5_BRIDGE_KEY_ID=local-v1
MT5_BRIDGE_URL=https://localhost:8443
MT5_COMMAND_TTL_SECONDS=10
MT5_HEARTBEAT_MAX_AGE_SECONDS=10
MT5_MAX_CLOCK_SKEW_SECONDS=3
MANAGED_MAGIC_NUMBER=730001

# Immutable safety envelope. Fractions: 0.01 means 1%.
HARD_MAX_RISK_PER_TRADE=0.01
HARD_MAX_DAILY_LOSS=0.03
HARD_MAX_TOTAL_OPEN_RISK=0.03
HARD_MAX_OPEN_POSITIONS=3
HARD_MAX_LOTS=1.00
HARD_MAX_EFFECTIVE_LEVERAGE=10
HARD_ALLOWED_SYMBOLS=[]
HARD_REQUIRE_STOP_LOSS=true
HARD_REQUIRE_TAKE_PROFIT=true
HARD_MAX_SIGNAL_AGE_SECONDS=120
HARD_MAX_SPREAD_POINTS={}
HARD_MAX_SLIPPAGE_POINTS={}

# Disabled notification adapter; no messages sent by setup.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=300

RAW_LOG_RETENTION_DAYS=7
AI_RESPONSE_RETENTION_DAYS=7
TELEGRAM_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=0
TRADE_RETENTION_DAYS=0
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
ENABLE_CRITIC_AGENT=false
ENABLE_ADAPTIVE_MEMORY=false
ENABLE_PENDING_ORDERS=false
ENABLE_PARTIAL_CLOSE=false

# Local host development. Containers use their internal service addresses.
API_PORT=8020
BRIDGE_PORT=8021
DASHBOARD_PORT=3000
API_INTERNAL_URL=https://api-production.example.com

COMPOSE_PROJECT_NAME=trd_production
